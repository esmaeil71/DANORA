# Database
DATABASE_URL=postgresql://danora:danora@localhost:5432/danora

# Redis (با docker compose پیش‌فرض host روی 6380 است — نه 6379)
REDIS_URL=redis://localhost:6380
REDIS_HOST_PORT=6380

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# API keys (server only — never expose to browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# App
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
FREE_DAILY_MESSAGE_LIMIT=50

# Next.js (browser calls API)
NEXT_PUBLIC_API_URL=http://localhost:4000